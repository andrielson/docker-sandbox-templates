{
  "name": "bun-devops-template",
  "version": "0.1.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check .",
    "lint:compose": "docker compose --file tests/docker-compose.yml config --quiet",
    "lint:fix": "biome check --write .",
    "lint:sh": "git ls-files '*.sh' | xargs --no-run-if-empty shellcheck",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "latest",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-sh": "0.19.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
